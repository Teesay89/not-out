rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /leaderboard/{entryId} {
      // Anyone can read the leaderboard.
      allow read: if true;

      // Nobody can write from the client SDK anymore — not create,
      // update, or delete. The only way a score reaches this collection
      // now is the submitScore Cloud Function, which uses the Admin SDK
      // and therefore bypasses these rules entirely. This is what
      // actually closes the loop: even a perfectly-crafted fake write
      // from a browser console has no path in.
      allow write: if false;
    }

    // Pack Draft's persistent per-user collection. A signed-in user may
    // read only their own document (for rendering "my collection" /
    // resuming a campaign) — everyone else's is invisible to them. Same
    // "Admin SDK only" write lockdown as leaderboard: pack rolls, series
    // verification, and duplicate redemption all happen in Cloud
    // Functions, never as a direct client write, so a forged "I own a 99"
    // has no path in either.
    match /packCollections/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }
  }
}
